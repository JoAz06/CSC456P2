<%- include('partials/header') %>
  <div id="external">
    <% users.forEach(user => { %>
      <div class="user">
        <ul>
          <li>Name: <%= user.name %></li>
          <li>Email: <%= user.email %></li>
          <li>Role: <%= user.role %></li>
          <li>Library Card ID: <%= user.libraryCard %></li>
        </ul>
      </div>
    <% }) %>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
